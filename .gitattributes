###############################################################################
# Ancestra
# Normalize all text files to UTF-8 + LF inside the repository
###############################################################################

# Default: all text files use LF
* text=auto eol=lf

###############################################################################
# Source Code
###############################################################################

*.rs         text eol=lf
*.ts         text eol=lf
*.tsx        text eol=lf
*.js         text eol=lf
*.jsx        text eol=lf
*.mjs        text eol=lf
*.cjs        text eol=lf

###############################################################################
# Web
###############################################################################

*.html       text eol=lf
*.css        text eol=lf
*.scss       text eol=lf
*.sass       text eol=lf
*.json       text eol=lf

###############################################################################
# Configuration
###############################################################################

*.yml        text eol=lf
*.yaml       text eol=lf
*.toml       text eol=lf
*.ini        text eol=lf
*.cfg        text eol=lf
*.conf       text eol=lf
*.env        text eol=lf

###############################################################################
# Documentation
###############################################################################

*.md         text eol=lf
*.txt        text eol=lf
*.sql        text eol=lf
*.csv        text eol=lf

###############################################################################
# Scripts
###############################################################################

*.sh         text eol=lf
*.ps1        text eol=lf
*.bat        text eol=lf

###############################################################################
# Git LFS
###############################################################################

*.png filter=lfs diff=lfs merge=lfs -text

###############################################################################
# Binary Files
###############################################################################

*.jpg        binary
*.jpeg       binary
*.gif        binary
*.webp       binary
*.ico        binary
*.bmp        binary
*.tif        binary
*.tiff       binary

*.pdf        binary

*.zip        binary
*.7z         binary
*.rar        binary

*.exe        binary
*.dll        binary
*.msi        binary

*.db         binary
*.sqlite     binary
*.sqlite3    binary